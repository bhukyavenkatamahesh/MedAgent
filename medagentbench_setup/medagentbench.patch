+def extract_action(content: str) -> str:
+    """procsafe lenient parse (LENIENT_PARSE=1). Identical copy of
+    procsafe.adapters.medagentbench.extract_action: returns the first GET / POST / FINISH(
+    line from a reply that wraps the action in prose."""
+    text = content.strip().replace('```tool_code', '').replace('```', '').strip()
+    lines = text.split('\n')
+    for i, line in enumerate(lines):
+        s = line.strip()
+        if s.startswith('GET '):
+            return s
+        if s.startswith('POST '):
+            rest = '\n'.join(lines[i + 1:])
+            start = rest.find('{')
+            if start >= 0:
+                try:
+                    obj, _ = json.JSONDecoder().raw_decode(rest[start:])
+                    return s + '\n' + json.dumps(obj)
+                except ValueError:
+                    pass
+            return s + ('\n' + rest if rest else '')
+        if s.startswith('FINISH('):
+            rest = '\n'.join(lines[i:])
+            return rest[: rest.rfind(')') + 1]
+    return text
